<header class="site-header">
  <div class="site-identity">
    <h1>
      <a href="/" @text="name"></a>
    </h1>
  </div>
  <div class="display-mode-controls" role="group" aria-label="Display options">
    <button class="display-mode-button" id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Light or dark mode">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="8"></circle>
        <path d="M12 4a8 8 0 0 1 0 16z" fill="currentcolor"></path>
      </svg>
    </button>
    <button class="display-mode-button" id="red-light-toggle" type="button" aria-pressed="false" aria-label="Turn red light on" title="Red light">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path class="bulb-body" d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"></path>
        <path d="M9.5 18.5h5"></path>
        <path d="M10.5 21h3"></path>
      </svg>
    </button>
  </div>
</header>
